      "ConfirmStatus": {
        "type": "string",
        "enum": [
          "未確認",
          "承認",
          "非承認"
        ],
        "title": "ConfirmStatus",
        "description": "アイデア・ミームの `confirmed` 列の値。ユーザが確かめたかを三段で持つ。\n\n- 未確認: 本文から自動で足した直後の候補。検索・生成・人物へ引く対象に出ない\n- 承認: ユーザが確かめた。使ってよい\n- 非承認: ユーザが退けた。使わないが、同じ語をまた候補に足さないよう行は残す"
      },
      "Decision": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ConfirmStatus"
