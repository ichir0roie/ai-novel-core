  "components": {
    "schemas": {
      "ChildListMeta": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnMeta"
            },
            "type": "array",
            "title": "Columns"
          }
        },
        "type": "object",
        "required": [
          "name",
          "label",
          "columns"
        ],
        "title": "ChildListMeta"
      },
      "ColumnMeta": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "integer",
              "number",
              "boolean",
              "string",
              "stamp",
              "json",
              "confirm",
              "id_list"
            ],
            "title": "Type"
          },
          "nullable": {
            "type": "boolean",
            "title": "Nullable"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "section": {
            "type": "boolean",
            "title": "Section",
            "default": false
          },
          "choices": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choices"
          },
          "references": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "References"
          },
          "readonly": {
            "type": "boolean",
            "title": "Readonly",
            "default": false
          },
          "create_only": {
            "type": "boolean",
            "title": "Create Only",
            "default": false
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "type",
          "nullable",
          "required"
        ],
        "title": "ColumnMeta"
      },
      "ConfirmStatus": {
        "type": "string",
        "enum": [
          "未確認",
          "承認",
          "非承認"
        ],
        "title": "ConfirmStatus",
        "description": "アイデア・ミームの `confirmed` 列の値。ユーザが確かめたかを三段で持つ。\n\n- 未確認: 本文から自動で足した直後の候補。検索・生成・人物へ引く対象に出ない\n- 承認: ユーザが確かめた。使ってよい\n- 非承認: ユーザが退けた。使わないが、同じ語をまた候補に足さないよう行は残す"
      },
      "Decision": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ConfirmStatus"
          },
          "changes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Changes"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Decision"
      },
      "EntranceList": {
        "properties": {
          "entrances": {
            "items": {
              "$ref": "#/components/schemas/EntranceMeta"
            },
            "type": "array",
            "title": "Entrances"
          },
          "claude_available": {
            "type": "boolean",
            "title": "Claude Available"
          }
        },
        "type": "object",
        "required": [
          "entrances",
          "claude_available"
        ],
        "title": "EntranceList"
      },
      "EntranceMeta": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "doc": {
            "type": "string",
            "title": "Doc"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/EntranceParam"
            },
            "type": "array",
            "title": "Params"
          },
          "claude": {
            "type": "boolean",
            "title": "Claude"
          },
          "writes": {
            "type": "boolean",
            "title": "Writes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "area",
          "name",
          "doc",
          "params",
          "claude",
          "writes"
        ],
        "title": "EntranceMeta"
      },
      "EntranceParam": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "default": {
            "title": "Default"
          },
          "annotation": {
            "type": "string",
            "title": "Annotation",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "required"
        ],
        "title": "EntranceParam"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "world_dir": {
            "type": "string",
            "title": "World Dir"
          },
          "db_path": {
            "type": "string",
            "title": "Db Path"
          }
        },
        "type": "object",
        "required": [
          "world_dir",
          "db_path"
        ],
        "title": "Health"
      },
      "JobInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "entrance": {
            "type": "string",
            "title": "Entrance"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status"
          },
          "result": {
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "entrance",
          "args",
          "status",
          "created_at"
        ],
        "title": "JobInfo"
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobInfo"
